<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>T7B4EPLHPK.com.codex.creditmenubar</string>
	<key>com.apple.developer.team-identifier</key>
	<string>T7B4EPLHPK</string>
	<!-- iPhone 원격 동기화(CloudKit 개인 데이터베이스)용 entitlement.
	     CCMB-iOS의 CCMB/CCMB.entitlements와 컨테이너 식별자가 같아야 하며,
	     Apple Developer 계정에서 iCloud.com.armsone.ccmb 컨테이너를 등록하고
	     프로비저닝 프로파일을 만든 뒤 서명 단계(codesign - -entitlements)에
	     이 파일을 포함해야 실제로 동작합니다. 서명에 포함되기 전까지 앱은
	     메뉴에 "iCloud 서명 없음"을 표시하고 업로드를 시도하지 않습니다. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.armsone.ccmb</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Developer ID 배포 앱은 Production CloudKit 환경을 사용한다. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
